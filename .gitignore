# ---------------------------------------------------------------------------
# Данные xraybox (секреты: UUID, REALITY-ключи, ссылки подписок)
# ---------------------------------------------------------------------------
# Игнорируем всё содержимое data/, но саму папку оставляем в репо
# (git не умеет «разыгнорить» файл внутри полностью игнорируемой папки,
#  поэтому именно data/*, а не data/).
data/*
!data/.gitkeep

# Явно на всякий случай (если кто-то поменяет правила выше)
data/state.json
data/state.legacy.json
data/config.json
data/config.json.*
data/process.json
data/xray.pid
data/tun-routes.json
data/.lock
data/logs/
data/legacy/
data/.*.json
data/.*.XXXXXX
data/.*.XXXXXX.*

# Бэкапы состояния, которые может создать пользователь руками
*.state.bak
*.state.json.bak
state.json.bak
config.json.bak

# ---------------------------------------------------------------------------
# Локальный бинарник Xray (кладётся вручную, не хранится в git)
# ---------------------------------------------------------------------------
/bin/xray
/bin/*.dat
!/bin/.gitkeep

# ---------------------------------------------------------------------------
# Python (у тебя в legacy лежит .pyc)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
.python-version

# ---------------------------------------------------------------------------
# Редакторы / IDE
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.\#*
\#*\#
*.iml

# ---------------------------------------------------------------------------
# ОС
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Временные файлы / логи / core dump
# ---------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.pid
*.lock
core
core.*
*.core

# ---------------------------------------------------------------------------
# Локальные оверрайды и секреты (если появятся)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.secret
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx
